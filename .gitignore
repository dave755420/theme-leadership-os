*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and packaging output
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Test and coverage output
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local data and caches. Raw or licensed market data must never be committed.
/data/raw/
/data/cache/
/data/staging/
/artifacts/local/
/.research_cache/
